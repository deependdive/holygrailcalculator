# Public — safe to ship to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...

# Server-only — NEVER expose to the browser. Used by /api routes for admin ops.
SUPABASE_SERVICE_ROLE_KEY=ey...

# Where the app is served. Used to build the OAuth redirect_to URL.
# Local: http://localhost:3000
# Vercel preview/prod: https://<your-vercel-app>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
